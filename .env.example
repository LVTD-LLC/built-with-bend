ENVIRONMENT=dev
DEBUG=True
# Generate locally, e.g. uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-generated-local-secret
SITE_URL=http://localhost:8000
# Omit DATABASE_URL for local SQLite. Production requires PostgreSQL.
# DATABASE_URL=postgres://user:password@localhost:5432/built_with_bend
TRUST_CAPROVER_PROXY=False
# Set bootstrap credentials securely in the hosting environment, never commit them.
# BEND_ADMIN_USERNAME=curator
# BEND_ADMIN_EMAIL=rasul@lvtd.dev
# BEND_ADMIN_PASSWORD=
# BEND_ADMIN_API_KEY=
